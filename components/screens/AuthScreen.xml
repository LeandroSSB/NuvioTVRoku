<component name="AuthScreen" extends="Group" initialFocus="emailKeyboard">
    <script type="text/brightscript" uri="AuthScreen.brs" />
    <interface>
        <field id="error" type="string" onChange="OnErrorSet" />
        <field id="email" type="string" value="" />
        <field id="password" type="string" value="" />
        <field id="signInRequested" type="bool" value="false" />
    </interface>
    <children>
        <Label id="headline" translation="[60, 40]" text="Entrar no Nuvio TV" font="font:LargeSystemFont" />
        <Label id="hint" translation="[60, 100]" text="Sua conta do backend Nuvio (e-mail e senha)." font="font:SmallSystemFont" />
        <MiniKeyboard id="emailKeyboard" translation="[60, 140]" />
        <MiniKeyboard id="passKeyboard" translation="[490, 140]" />
        <Button id="signInButton" translation="[60, 644]" text="Entrar" />
        <Label id="error" translation="[420, 650]" width="560" height="56" font="font:SmallSystemFont" color="0xE57373" wrap="true" />
    </children>
</component>

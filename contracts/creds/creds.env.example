# Copie para creds.env e preencha. NUNCA comite creds.env (já no .gitignore).
# Preencha com: URL do seu backend Nuvio + e-mail/senha da sua conta Nuvio
# + o manifest URL atual do seu AIOStreams.
NUVIO_BACKEND_URL=https://nuvio.leandrossb.com
NUVIO_EMAIL=
NUVIO_PASSWORD=
# ÚLTIMO manifest URL salvo do AIOStreams (rotaciona a cada Save no configure).
# O contrato 04 prefere a URL da tabela addons; isto é só fallback.
AIOSTREAMS_MANIFEST_URL=
